   "source": [
    "# 提取下载的sh文件中的下载链接\n",
    "import re\n",
    "\n",
    "# sh文件的路径\n",
    "f = open(\"xxx.sh\", 'r')\n",
    "content = f.read()\n",
    "patten = \"http://.*.nc\"\n",
    "result = re.findall(patten, content)\n",
    "\n",
    "# 将提取的下载链接保存到文本文档\n",
    "wf = open(\"xxx.txt\",'w')\n",
    "wf.write('\\n'.join(result))"
   ]
  }
 ],
